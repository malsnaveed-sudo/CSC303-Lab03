<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Label and Input for Device Name -->
    <TextView
        android:id="@+id/lblDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_device_name"
        android:labelFor="@+id/etDeviceName"
        android:textSize="16sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_device_name"
        android:inputType="textCapSentences"
        android:minHeight="48dp"
        android:layout_marginBottom="16dp" />

    <!-- Label and Input for Battery Level -->
    <TextView
        android:id="@+id/lblBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_battery_level"
        android:labelFor="@+id/etBattery"
        android:textSize="16sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_battery_level"
        android:inputType="numberSigned"
        android:minHeight="48dp"
        android:layout_marginBottom="24dp" />

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_save"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_cancel" />

</LinearLayout>