<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDeviceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/device_name_label"
        android:textSize="18sp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvBattery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/battery_level_label"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnEditDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_edit_device"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOpenDocumentation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_doc" />

</LinearLayout>